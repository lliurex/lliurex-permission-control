#: ../lliurex-permission-control.install/ui/lliurex-permission-control:18
msgid "Lliurex-Permission-Control is now running. Wait a moment and try again."
msgstr ""
"Lliurex-Permission-Control està en execució. Espereu un moment i torneu-ho a "
"provar."

#: ../lliurex-permission-control.install/ui/lliurex-permission-control:32
msgid "You need administration privileges to run this application."
msgstr "No tenieu privilegis per a executar aquesta aplicació."

#: ../lliurex-permission-control.install/ui/rsrc/ApplicationOptions.qml:27
msgid "Permission for Students"
msgstr "Permisos per a Alumnes"

#: ../lliurex-permission-control.install/ui/rsrc/ApplicationOptions.qml:39
msgid "Permission for Teachers"
msgstr "Permisos per a Professors"

#: ../lliurex-permission-control.install/ui/rsrc/ApplicationOptions.qml:52
msgid "Help"
msgstr "Ajuda"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:11
msgid "Permission available for students"
msgstr "Permisos disponibles per a Alumnes"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:64
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:64
#: ../lliurex-permission-control.install/ui/rsrc/ChangesDialog.qml:54
msgid "Apply"
msgstr "Aplica"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:80
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:80
#: ../lliurex-permission-control.install/ui/rsrc/ChangesDialog.qml:94
msgid "Cancel"
msgstr "Cancel·la"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:95
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:95
msgid ""
"The are pending changes to apply.\n"
"Do you want apply the changes or discard them?"
msgstr ""
"Hi ha canvis pendents d’aplicar.\n"
"Voleu aplicar els canvis o descartar-los?"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:132
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:132
msgid "Changes applied successfully"
msgstr "Canvis aplicats correctament"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:135
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:135
msgid "An error ocurred while applying changes"
msgstr "S'ha produït un error en aplicar els canvis"

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:159
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:159
msgid "Apply changes. Wait a moment..."
msgstr "S’estan aplicant els canvis. Espereu un moment..."

#: ../lliurex-permission-control.install/ui/rsrc/StudentSettings.qml:170
#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:170
msgid "Restoring previous values. Wait a moment..."
msgstr "S’estan restaurant els valors previs. Espereu un moment..."

#: ../lliurex-permission-control.install/ui/rsrc/StudentList.qml:50
#: ../lliurex-permission-control.install/ui/rsrc/TeacherList.qml:50
msgid "No permission found to configure"
msgstr "No s'han trobat permisos per a configurar"

#: ../lliurex-permission-control.install/ui/rsrc/ListDelegateStudentItem.qml:45
msgid "Check to remove students users from this group"
msgstr "Feu clic per a eliminar usuaris del grup Alumnes a este grup"

#: ../lliurex-permission-control.install/ui/rsrc/ListDelegateStudentItem.qml:45
msgid "Check to add studentes users to this group"
msgstr "Feu clic per a afegir usuaris del grup Alumnes a este grup"

#: ../lliurex-permission-control.install/ui/rsrc/TeacherSettings.qml:11
msgid "Permission available for teachers"
msgstr "Permisos disponibles per a Professors"

#: ../lliurex-permission-control.install/ui/rsrc/ListDelegateTeacherItem.qml:44
msgid "Check to remove teachers users from this group"
msgstr "Feu clic per a eliminar usuaris del grup Professors a este grup"

#: ../lliurex-permission-control.install/ui/rsrc/ListDelegateTeacherItem.qml:44
msgid "Check to add teachers users to this group"
msgstr "Feu clic per a afegir usuaris del grup Professors a este grup"

#: ../lliurex-permission-control.install/ui/rsrc/Loading.qml:40
msgid "Loading. Wait a moment..."
msgstr "S’està carregant. Espereu un moment..."

#: ../lliurex-permission-control.install/ui/rsrc/ChangesDialog.qml:74
msgid "Discard"
msgstr "Descarta"
